{
  "name": "nexus-bot-manager",
  "version": "1.1.7",
  "description": "Self-hosted Discord bot manager for Proxmox LXC environments",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "npm run check && npm run test:unit && npm run test:boot",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "test:security": "node --test test/security.test.js",
    "test:functional": "node --test test/functional.test.js",
    "test:boot": "node test/boot.smoke.js",
    "check": "node scripts/syntax-check.js",
    "audit:handlers": "node scripts/audit-inline-handlers.js"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pm2": "7.1.2",
    "socket.io": "^4.7.4",
    "systeminformation": "^5.21.24",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "bot-manager",
    "proxmox",
    "lxc",
    "pm2"
  ]
}
