# ---------------------------------------------------
# Nexus Bot Manager — Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ---------------------------------------------------

# Server
PORT=3001
NODE_ENV=production

# Listen address. Default 0.0.0.0 (all interfaces). Set 127.0.0.1 when a
# local reverse proxy is the only intended entry point.
# HOST=127.0.0.1

# ---------------------------------------------------
# JWT_SECRET — REQUIRED, and it must be a real secret.
#
# The value below is intentionally EMPTY. A placeholder of
# 32+ characters would be accepted by the server at boot while
# being published in this repository, which makes forging an
# admin token trivial for anyone who reads it.
#
# Generate your own (128 hex characters, 512 bits):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# The server refuses to start when JWT_SECRET is empty, shorter
# than 32 bytes, still equal to the value in this file, or too
# repetitive to carry enough entropy.
# ---------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Optional: read the signing key from a 0400/0600 file instead of writing
# it in this .env (useful with systemd LoadCredential or a root-owned file).
# JWT_SECRET_FILE=/etc/nexus/jwt.secret

# ---------------------------------------------------
# Optional — leave unset for the default (single-user
# self-hosted panel). Uncomment only if you know why.
# ---------------------------------------------------

# Extra origins allowed to call the API (comma-separated).
# The panel's own origin is always allowed; same-origin requests
# and non-browser clients (curl, scripts) are never blocked.
# CORS_ORIGIN=https://panel.example.lan

# Only enable when the app really is behind a reverse proxy, otherwise
# any client can forge X-Forwarded-For and defeat the rate limiters.
# TRUST_PROXY=1

# Escape hatch for a self-hosted fork whose releases are not published
# on GitHub Releases. Leave unset: an unverified archive is arbitrary
# code executed as root. See backend/release-digests.json.
# NEXUS_UPDATE_ALLOW_UNVERIFIED=0

# Set to false only to disable the Content-Security-Policy header.
# CSP_ENABLED=true

# Bot storage root directory
# Must be a POSIX absolute path on Linux (the production target).
# Do NOT use a Windows path (C:\...) on a Linux host: the bots would
# be created under a literal directory named "C:\opt".
BOTS_ROOT=/opt

# Instance name (shown in UI, can be changed in settings)
INSTANCE_NAME=Nexus Bot Manager
